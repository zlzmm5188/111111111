# ==================== AGX H5 环境变量配置模板 ====================
# 复制此文件为 .env 并填写实际值
# 警告：切勿将 .env 文件提交到版本控制系统！

# ==================== 域名配置（核心）====================
# 只需配置主域名，其他域名会自动生成：
# - API域名会自动生成为: api.{VITE_MAIN_DOMAIN}
# - WebSocket会自动生成为: wss://{VITE_MAIN_DOMAIN}
# - 邀请链接会自动生成为: https://{VITE_MAIN_DOMAIN}/register?invite=xxx
# - 管理后台会自动生成为: admin.{VITE_MAIN_DOMAIN}
VITE_MAIN_DOMAIN=your-domain.com

# ==================== API配置 ====================
# API服务器地址（相对路径，由nginx代理到 api.{主域名}）
VITE_API_BASE_URL=/api

# ==================== 应用配置 ====================
# 应用环境 (development, production, staging)
VITE_APP_ENV=production

# 是否启用调试模式 (true, false)
VITE_DEBUG=false

# ==================== 其他配置 ====================
# 人民币汇率（用于资产换算显示）
VITE_CNY_RATE=7.25

# ==================== 功能开关 ====================
# 是否启用Sentry监控 (true, false)
VITE_ENABLE_SENTRY=false

# ==================== 说明 ====================
# 
# 域名示例：
# 
# 开发环境:
#   VITE_MAIN_DOMAIN=localhost:5173
#   自动生成: API -> localhost:3001, WebSocket -> ws://localhost:3001
# 
# 生产环境:
#   VITE_MAIN_DOMAIN=agx.bi
#   自动生成: API -> api.agx.bi, WebSocket -> wss://agx.bi
# 
# 更换域名只需修改一个变量:
#   VITE_MAIN_DOMAIN=myapp.com
#   自动生成: API -> api.myapp.com, WebSocket -> wss://myapp.com
#   无需修改其他任何配置！
