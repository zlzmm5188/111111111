# AGX H5 - 生产环境配置
# npm run build 时自动加载

# ==================== 域名配置（核心）====================
# 只需配置主域名，其他域名会自动生成：
# - API域名: api.{VITE_MAIN_DOMAIN}
# - WebSocket: wss://{VITE_MAIN_DOMAIN}
# - 邀请链接: https://{VITE_MAIN_DOMAIN}
VITE_MAIN_DOMAIN=bycxe.top

# ==================== API配置 ====================
# API地址（生产环境，由nginx代理到 api.{主域名}）
VITE_API_BASE_URL=/api

# ==================== 应用配置 ====================
# 生产环境
VITE_APP_ENV=production

# 关闭调试
VITE_DEBUG=false

# ==================== 其他配置 ====================
# 人民币汇率
VITE_CNY_RATE=7.25
