# AGX H5 - 开发环境配置
# npm run dev 时自动加载

# ==================== 域名配置 ====================
# 开发环境使用localhost
VITE_MAIN_DOMAIN=localhost:5173

# ==================== API配置 ====================
# API地址（开发环境代理到本地后端 localhost:3001）
VITE_API_BASE_URL=/api

# ==================== 应用配置 ====================
# 开发环境
VITE_APP_ENV=development

# 开启调试
VITE_DEBUG=true
