# AGX Backend - Development Environment Configuration
# 此文件仅用于本地开发，连接 Docker 测试数据库

# Server
PORT=3001
NODE_ENV=development

# Base URL (for file access and callbacks)
BASE_URL=http://localhost:3001

# CORS 允许的前端域名 (开发环境)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database - Docker Test Database
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=agx_test
DB_PASSWORD=dev_test_password_2026
DB_DATABASE=agx_test

# JWT
JWT_SECRET=DevJwtSecret2026ForTestingOnly
JWT_EXPIRES_IN=7d

# TRON (测试配置，不连接真实链)
TRONGRID_API_KEYS=test_key_1,test_key_2
TRON_USDT_ADDRESS=TTestAddressForDevelopment
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# DeepSeek API (开发环境)
DEEPSEEK_API_KEY=sk-test-dev-key-placeholder
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_TEMPERATURE=0.0

# Agent 配置
DEEPSEEK_AGENT_MODEL=deepseek-reasoner
AGENT_WORK_DIR=/root/agx-dev

# Writer 配置
DEEPSEEK_WRITER_MODEL=deepseek-reasoner

# Claude API (开发环境)
CLAUDE_API_KEY=test-claude-key-placeholder
CLAUDE_BASE_URL=https://api.z.ai/api/anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=16384
CLAUDE_TEMPERATURE=0.0
