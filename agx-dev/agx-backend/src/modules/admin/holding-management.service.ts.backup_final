import { Injectable, Logger } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository, Between } from 'typeorm';
import { HoldingDistribution, HoldingConfig, GoldAccount } from '../../entities';
import { OperationLogService } from '../../common/services/operation-log.service';
import { Cron } from '@nestjs/schedule';
import { MarketService } from '../market/market.service';

/**
 * 持币生金管理服务
 * 金融级严谨性要求
 */
@Injectable()
export class HoldingManagementService {
  private readonly logger = new Logger(HoldingManagementService.name);

  constructor(
    @InjectRepository(HoldingConfig)
    private readonly holdingConfigRepo: Repository<HoldingConfig>,
    @InjectRepository(HoldingDistribution)
    private readonly distributionRepo: Repository<HoldingDistribution>,
    @InjectRepository(GoldAccount)
    private readonly goldAccountRepo: Repository<GoldAccount>,
    private readonly operationLog: OperationLogService,
    private readonly marketService: MarketService,
  ) {}

  /**
   * 获取配置列表
   */
  async getConfigs() {
    return this.holdingConfigRepo.find({
      where: { status: 1 },
      order: { sortOrder: 'ASC', minAgx: 'ASC' },
    });
  }

  /**
   * 更新配置
   */
  async updateConfig(
    id: number,
    data: {
      levelName?: string;
      minAgx?: string;
      maxAgx?: string;
      dailyOzRate?: string;
      description?: string;
      sortOrder?: number;
      status?: number;
    },
    admin: { id: number; username: string },
    ip?: string,
  ) {
    const existing = await this.holdingConfigRepo.findOne({ where: { id } });
    if (!existing) {
      throw new Error('配置不存在');
    }

    // 验证数据
    this.validateConfigData(data);

    // 记录变更
    const changes: any = {};
    Object.keys(data).forEach(key => {
      if (data[key] !== undefined && data[key] !== existing[key]) {
        changes[key] = { old: existing[key], new: data[key] };
      }
    });

    const updated = await this.holdingConfigRepo.save({
      ...existing,
      ...data,
    });

    // 记录审计日志
    await this.operationLog.logSuccess({
      adminId: admin.id,
      adminUsername: admin.username,
      module: 'holding_config',
      action: 'update',
      targetType: 'HoldingConfig',
      targetId: id,
      oldData: existing,
      newData: updated,
      changes,
      ip,
    });

    this.logger.log(`持币生金配置更新成功: ID=${id}`);
    return updated;
  }

  /**
   * 手动触发发放
   */
  async manualDistribution(
    targetDate: string,
    admin: { id: number; username: string },
    ip?: string,
  ) {
    this.logger.log(`手动触发持币生金发放: 日期=${targetDate}`);

    try {
      const result = await this.distributeHoldingReward(new Date(targetDate));
      return {
        code: 0,
        msg: '发放成功',
        data: result,
      };
    } catch (error) {
      await this.operationLog.logFailure({
        adminId: admin.id,
        adminUsername: admin.username,
        module: 'holding_distribution',
        action: 'manual',
        targetType: 'ManualDistribution',
        oldData: { targetDate },
        error,
        ip,
      });
      throw error;
    }
  }

  /**
   * 定时任务：每日自动发放
   * 每天凌晨1点执行
   */
  @Cron('0 1 * * *', {
    name: 'daily-holding-distribution',
    timeZone: 'Asia/Shanghai',
  })
  async dailyDistribution() {
    this.logger.log('开始执行每日持币生金发放');

    try {
      const yesterday = new Date();
      yesterday.setDate(yesterday.getDate() - 1);

      const result = await this.distributeHoldingReward(yesterday);
      this.logger.log(`每日持币生金发放完成: 处理${result.processed}用户, 发放${result.totalOz}oz`);
    } catch (error) {
      this.logger.error('每日持币生金发放失败:', error);
      throw error;
    }
  }

  /**
   * 核心发放逻辑
   */
  private async distributeHoldingReward(distributionDate: Date) {
    // 获取所有有效配置
    const configs = await this.holdingConfigRepo.find({
      where: { status: 1 },
      order: { sortOrder: 'ASC' },
    });

    if (configs.length === 0) {
      throw new Error('没有有效的持币生金配置');
    }

    // 获取所有有AGX持仓的用户
    const users = await this.goldAccountRepo
      .createQueryBuilder('account')
      .where('account.ozBalance > :minBalance', { minBalance: 0 })
      .getMany();

    let processed = 0;
    let totalOz = 0;

    for (const user of users) {
      try {
        const holdingOz = parseFloat(user.ozBalance);

        // 找到对应的配置等级
        const config = this.findUserConfig(holdingOz, configs);
        if (!config) continue;

        // 计算应发放的黄金
        const distributedOz = holdingOz * parseFloat(config.dailyOzRate);

        if (distributedOz <= 0) continue;

        // 创建发放记录
        const record = this.distributionRepo.create({
          userId: user.id,
          distributionDate,
          holdingAgx: '0', // 这里需要从Wallet表获取实际AGX数量
          holdingOz: holdingOz.toFixed(6),
          holdingLevel: config.levelName,
          distributedOz: distributedOz.toFixed(6),
          distributedGram: (distributedOz * 31.1035).toFixed(6), // oz转克
          distributionRate: config.dailyOzRate,
                    // 获取实时AGX价格          let agxPrice = '0.065';          try {            const agxTicker = await this.marketService.getTicker('AGXUSDT');            if (agxTicker && agxTicker.lastPrice && agxTicker.lastPrice !== '0') {              agxPrice = agxTicker.lastPrice;              this.logger.log('获取到AGX实时价格: ' + agxPrice);            } else {              this.logger.warn('无法获取AGX实时价格，使用默认值0.065');            }          } catch (error) {            this.logger.error('获取AGX价格失败:', error.message);          }          agxPrice: agxPrice,
          goldPriceOz: '2000', // 这里应该从价格服务获取实时价格
          estimatedValue: (distributedOz * 2000).toFixed(8),
          calculationFormula: JSON.stringify({
            holdingOz,
            rate: config.dailyOzRate,
            formula: 'holdingOz * dailyOzRate',
          }),
          status: 1, // 已发放
          issuedAt: new Date(),
        });

        await this.distributionRepo.save(record);

        // 更新用户账户
        const newOzBalance = parseFloat(user.ozBalance) + distributedOz;
        const newOzFromHolding = parseFloat(user.ozFromHolding) + distributedOz;
        const newOzTotalEarned = parseFloat(user.ozTotalEarned) + distributedOz;

        await this.goldAccountRepo.update(user.id, {
          ozBalance: newOzBalance.toFixed(6),
          ozFromHolding: newOzFromHolding.toFixed(6),
          ozTotalEarned: newOzTotalEarned.toFixed(6),
          lastSettlementDate: distributionDate.toISOString().split('T')[0],
        });

        processed++;
        totalOz += distributedOz;
      } catch (error) {
        this.logger.error(`用户${user.id}发放失败:`, error);
        // 创建失败记录
        await this.distributionRepo.save({
          userId: user.id,
          distributionDate,
          holdingOz: '0',
          holdingLevel: '',
          distributedOz: '0',
          distributedGram: '0',
          status: 2, // 发放失败
          remark: error.message,
        });
      }
    }

    return { processed, totalOz: totalOz.toFixed(6) };
  }

  /**
   * 获取发放记录
   */
  async getDistributions(filters: {
    userId?: number;
    distributionDate?: string;
    status?: number;
    startDate?: string;
    endDate?: string;
    page?: number;
    pageSize?: number;
    keyword?: string;
    userType?: string;
  }) {
    const query = this.distributionRepo.createQueryBuilder('dist')
      .leftJoinAndSelect('dist.user', 'user')
      .leftJoinAndSelect('user.kyc', 'kyc');

    if (filters.userId) {
      query.andWhere('dist.userId = :userId', { userId: filters.userId });
    }
    if (filters.distributionDate) {
      query.andWhere('dist.distributionDate = :distributionDate', {
        distributionDate: filters.distributionDate
      });
    }
    if (filters.status !== undefined) {
      query.andWhere('dist.status = :status', { status: filters.status });
    }
    if (filters.startDate && filters.endDate) {
      query.andWhere('dist.distributionDate BETWEEN :startDate AND :endDate', {
        startDate: filters.startDate,
        endDate: filters.endDate,
      });
    }

    // 实名搜索
    if (filters.keyword) {
      query.andWhere(
        '(user.username LIKE :keyword OR user.uid LIKE :keyword OR kyc.realName LIKE :keyword)',
        { keyword: `%${filters.keyword}%` }
      );
    }

    // 用户类型筛选
    if (filters.userType === 'internal') {
      query.andWhere('user.isInternal = :isInternal', { isInternal: 1 });
    } else if (filters.userType === 'normal') {
      query.andWhere('user.isInternal = :isInternal', { isInternal: 0 });
    }

    const page = filters.page || 1;
    const pageSize = filters.pageSize || 20;

    query
      .orderBy('dist.distributionDate', 'DESC')
      .addOrderBy('dist.createdAt', 'DESC')
      .skip((page - 1) * pageSize)
      .take(pageSize);

    const [list, total] = await query.getManyAndCount();

    // 统计汇总
    const stats = await this.distributionRepo
      .createQueryBuilder('dist')
      .select([
        'COUNT(DISTINCT dist.userId) as userCount',
        'SUM(dist.distributedOz) as totalOz',
        'SUM(dist.distributedGram) as totalGram',
      ])
      .where('dist.status = :status', { status: 1 })
      .getRawOne();

    return {
      list,
      total,
      page,
      pageSize,
      totalPages: Math.ceil(total / pageSize),
      summary: {
        totalUsers: parseInt(stats.userCount) || 0,
        totalOz: stats.totalOz || '0',
        totalGram: stats.totalGram || '0',
      },
    };
  }

  /**
   * 导出发放记录
   */
  async exportDistributions(filters: {
    userId?: number;
    distributionDate?: string;
    status?: number;
    startDate?: string;
    endDate?: string;
    keyword?: string;
    userType?: string;
  }) {
    const query = this.distributionRepo.createQueryBuilder('dist')
      .leftJoinAndSelect('dist.user', 'user')
      .leftJoinAndSelect('user.kyc', 'kyc');

    if (filters.userId) {
      query.andWhere('dist.userId = :userId', { userId: filters.userId });
    }
    if (filters.distributionDate) {
      query.andWhere('dist.distributionDate = :distributionDate', {
        distributionDate: filters.distributionDate
      });
    }
    if (filters.status !== undefined) {
      query.andWhere('dist.status = :status', { status: filters.status });
    }
    if (filters.startDate && filters.endDate) {
      query.andWhere('dist.distributionDate BETWEEN :startDate AND :endDate', {
        startDate: filters.startDate,
        endDate: filters.endDate,
      });
    }

    // 实名搜索
    if (filters.keyword) {
      query.andWhere(
        '(user.username LIKE :keyword OR user.uid LIKE :keyword OR kyc.realName LIKE :keyword)',
        { keyword: `%${filters.keyword}%` }
      );
    }

    // 用户类型筛选
    if (filters.userType === 'internal') {
      query.andWhere('user.isInternal = :isInternal', { isInternal: 1 });
    } else if (filters.userType === 'normal') {
      query.andWhere('user.isInternal = :isInternal', { isInternal: 0 });
    }

    query
      .orderBy('dist.distributionDate', 'DESC')
      .addOrderBy('dist.createdAt', 'DESC')
      .limit(10000); // 限制导出数量

    const list = await query.getMany();

    return list.map(item => ({
      用户ID: item.userId,
      用户名: item.user?.username || '',
      真实姓名: item.user?.kyc?.realName || '未实名',
      用户类型: item.user?.isInternal === 1 ? '内部人员' : '普通会员',
      持仓AGX: item.holdingAgx,
      持仓黄金oz: item.holdingOz,
      持仓等级: item.holdingLevel,
      发放黄金oz: item.distributedOz,
      发放黄金克: item.distributedGram,
      发放费率: item.distributionRate,
      AGX价格: item.agxPrice,
      黄金价格: item.goldPriceOz,
      估值USDT: item.estimatedValue,
      状态: item.status === 1 ? '已发放' : item.status === 0 ? '待发放' : '发放失败',
      发放日期: item.distributionDate,
      实际发放时间: item.issuedAt,
      备注: item.remark || '',
    }));
  }

  /**
   * 根据持仓量查找对应配置
   */
  private findUserConfig(holdingOz: number, configs: HoldingConfig[]): HoldingConfig | null {
    for (const config of configs) {
      const min = parseFloat(config.minAgx);
      const max = config.maxAgx ? parseFloat(config.maxAgx) : Infinity;

      if (holdingOz >= min && holdingOz <= max) {
        return config;
      }
    }
    return null;
  }

  /**
   * 验证配置数据
   */
  private validateConfigData(data: any) {
    if (data.minAgx !== undefined && parseFloat(data.minAgx) < 0) {
      throw new Error('最低持仓不能为负数');
    }
    if (data.maxAgx !== undefined && parseFloat(data.maxAgx) < parseFloat(data.minAgx)) {
      throw new Error('最高持仓不能小于最低持仓');
    }
    if (data.dailyOzRate !== undefined && parseFloat(data.dailyOzRate) <= 0) {
      throw new Error('日收益率必须大于0');
    }
  }
}
