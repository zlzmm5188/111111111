# .env.production
VITE_APP_ENV = production
VITE_APP_TITLE = AGX Admin
VITE_APP_BASE = /

# API 基础地址（使用 HTTPS 域名，禁止 HTTP IP 直连）
VITE_APP_BASE_URL = https://api.bycxe.top
VITE_APP_OPEN_PROXY = false

# WebSocket 地址
VITE_APP_WS_URL = wss://api.bycxe.top

# API 代理前缀（开发环境使用）
VITE_APP_PROXY_PREFIX = /api

# Token 前缀
VITE_APP_TOKEN_PREFIX = admin_token