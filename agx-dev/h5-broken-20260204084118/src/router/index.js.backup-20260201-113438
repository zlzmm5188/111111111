/**
 * AGX - 修复版路由配置
 * 修复 x.get() 错误问题
 */

import { createRouter, createWebHistory } from 'vue-router'
import { tokenStorage } from '../utils/security'

// Create router
const router = createRouter({
  history: createWebHistory(),
  routes: [
    // 启动页
    {
      path: '/splash',
      name: 'Splash',
      component: () => import('@/views/Splash.vue'),
      meta: { title: 'AGX' }
    },
    // 主页
    {
      path: '/',
      redirect: '/splash'
    },
    {
      path: '/home',
      name: 'Home',
      component: () => import('@/views/Home.vue'),
      meta: { title: 'AGX', showTabBar: true }
    },
    // 登录页 - 核心页面
    {
      path: '/login',
      name: 'Login',
      component: () => import('@/views/Login.vue'),
      meta: { title: '登录' }
    },
    // 注册页
    {
      path: '/register',
      name: 'Register',
      component: () => import('@/views/Register.vue'),
      meta: { title: '注册' }
    },
    // 广场
    {
      path: '/square',
      name: 'Square',
      component: () => import('@/views/Square.vue'),
      meta: { title: '广场', showTabBar: true }
    },
    // 团队页面
    {
      path: '/team',
      name: 'Team',
      component: () => import('@/views/Team.vue'),
      meta: { title: '团队介绍' }
    },
    // 个人中心 - 修复：移除认证要求
    {
      path: '/mine',
      name: 'Mine',
      component: () => import('@/views/Mine.vue'),
      meta: { title: '我的', showTabBar: true }
    },
    // 行情
    {
      path: '/markets',
      name: 'Markets',
      component: () => import('@/views/Markets/index.vue'),
      meta: { title: '行情', showTabBar: true }
    },
    // AGX页面
    {
      path: '/agx',
      name: 'AGX',
      component: () => import('@/views/AGX.vue'),
      meta: { title: 'AGX', showTabBar: true }
    },
    // 关于页面
    {
      path: '/about',
      name: 'About',
      component: () => import('@/views/About.vue'),
      meta: { title: '关于我们' }
    },
    // 帮助页面
    {
      path: '/help',
      name: 'Help',
      component: () => import('@/views/Help.vue'),
      meta: { title: '帮助中心' }
    },
    // 404页面 - 重定向到首页
    {
      path: '/:pathMatch(.*)*',
      name: 'NotFound',
      redirect: '/home'
    }
  ]
})

// 简单的路由守卫，只设置页面标题
// 完全移除认证检查，避免 x.get() 错误
router.beforeEach((to, from, next) => {
  // 设置页面标题
  if (to.meta.title) {
    document.title = to.meta.title + ' - AGX生态'
  }
  
  // 确保 tokenStorage 可用（避免压缩错误）
  if (typeof tokenStorage !== 'undefined' && tokenStorage.getToken) {
    // tokenStorage 可用，但不进行认证检查
    console.log('tokenStorage available');
  }
  
  next()
})

export default router
