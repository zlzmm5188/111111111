<template>
  <div class="invite-page">
    <!-- 导航栏 -->
    <header class="nav-header">
      <button class="icon-btn" @click="$router.back()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
      </button>
      <h1 class="nav-title">邀请好友</h1>
      <button class="icon-btn" @click="$router.push('/invite-records')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      </button>
    </header>

    <main class="main-content">
      <!-- 收益卡片 -->
      <section class="earnings-card">
        <div class="earnings-label">累计收益 (USDT)</div>
        <div class="earnings-amount">${{ totalReward }}</div>
        <div class="earnings-stats">
          <div class="stat">
            <div class="stat-value">{{ directCount }}</div>
            <div class="stat-label">邀请人数</div>
          </div>
          <div class="stat">
            <div class="stat-value">{{ totalPositions }}</div>
            <div class="stat-label">建仓人数</div>
          </div>
          <div class="stat">
            <div class="stat-value">{{ usedBonusCount }}/10</div>
            <div class="stat-label">赠币次数</div>
          </div>
        </div>
      </section>

      <!-- 邀请码区域 -->
      <section class="invite-code-card">
        <div class="invite-header">
          <div class="invite-icon">✨</div>
          <div class="invite-title">我的邀请码</div>
        </div>
        <div class="code-box">
          <span class="invite-code">{{ inviteCode }}</span>
          <button class="copy-icon-btn" @click="copyCode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
          </button>
        </div>
        <div class="action-buttons">
          <button class="action-btn primary" @click="copyLink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            复制链接
          </button>
          <button class="action-btn" @click="showQRModal = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
            </svg>
            二维码
          </button>
        </div>
      </section>

      <!-- 奖励进度 -->
      <section class="progress-card">
        <div class="progress-header">
          <h2 class="section-title">奖励进度</h2>
          <div class="progress-tabs">
            <button
              :class="['tab-btn', { active: activeProgressTab === 'commission' }]"
              @click="activeProgressTab = 'commission'"
            >
              返佣奖励
            </button>
            <button
              :class="['tab-btn', { active: activeProgressTab === 'bonus' }]"
              @click="activeProgressTab = 'bonus'"
            >
              赠币奖励
            </button>
          </div>
        </div>

        <!-- 返佣进度 -->
        <div v-show="activeProgressTab === 'commission'" class="progress-content">
          <div class="progress-info">
            <span>{{ totalPositions }} 人建仓</span>
            <span class="highlight">当前返佣 {{ currentTierRate }}</span>
          </div>
          <div class="tier-list">
            <div
              v-for="(tier, idx) in commissionTiers"
              :key="tier.tierLevel"
              class="tier-item"
              :class="{ active: totalPositions >= tier.minInvites, current: isCurrentTier(tier) }"
            >
              <div class="tier-dot">
                <svg v-if="totalPositions >= tier.minInvites" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span v-else>{{ idx + 1 }}</span>
              </div>
              <div class="tier-info">
                <span class="tier-label">{{ tier.label }}</span>
                <span class="tier-rate">{{ tier.rate }}</span>
              </div>
              <div v-if="idx < commissionTiers.length - 1" class="tier-line"></div>
            </div>
          </div>
        </div>

        <!-- 赠币进度 -->
        <div v-show="activeProgressTab === 'bonus'" class="progress-content">
          <div class="bonus-info">
            <div class="bonus-item">
              <span class="bonus-label">已邀请</span>
              <span class="bonus-value">{{ usedBonusCount }}/10</span>
            </div>
            <div class="bonus-item">
              <span class="bonus-label">累计获得</span>
              <span class="bonus-value highlight">{{ bonusStats.totalBonus || '0' }} AGX</span>
            </div>
          </div>

          <div v-if="bonusStats.isMaxReached" class="complete-badge">
            🎉 恭喜！10次赠币奖励已全部领取
          </div>

          <div class="bonus-grid">
            <div
              v-for="tier in bonusTiers"
              :key="tier.inviteOrder"
              class="bonus-item"
              :class="{ active: usedBonusCount >= tier.inviteOrder }"
            >
              <div class="bonus-num">{{ tier.inviteOrder }}</div>
              <div class="bonus-amount">+{{ tier.inviterBonus }}</div>
            </div>
          </div>
        </div>
      </section>

      <!-- 规则说明 -->
      <section class="rules-card">
        <h2 class="section-title">奖励规则</h2>
        <div class="rules-list">
          <div class="rule-item">
            <div class="rule-icon">💰</div>
            <p><strong>赠币奖励：</strong>好友完成KYC后双方获得AGX，最高可得 <strong>90 AGX</strong></p>
          </div>
          <div class="rule-item">
            <div class="rule-icon">📈</div>
            <p><strong>返佣奖励：</strong>按建仓人数计算返佣，最高可达 <strong>30%</strong></p>
          </div>
          <div class="rule-item">
            <div class="rule-icon">⚡</div>
            <p>好友完成KYC或建仓后立即发放奖励，无需等待</p>
          </div>
        </div>
      </section>
    </main>

    <!-- 二维码弹窗 -->
    <Teleport to="body">
      <Transition name="modal">
        <div v-if="showQRModal" class="modal-overlay" @click="showQRModal = false">
          <div class="modal-content" @click.stop>
            <h3>邀请二维码</h3>
            <div class="qr-code-box">
              <div class="qr-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                </svg>
              </div>
              <div class="qr-code-text">{{ inviteCode }}</div>
            </div>
            <button class="modal-btn" @click="copyLink">复制邀请链接</button>
          </div>
        </div>
      </Transition>
    </Teleport>
  </div>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'
import { alert } from '../utils/alert'
import { api } from '../utils/api'

const inviteCode = ref('AGX2024')
const inviteLink = ref('')
const inviteText = ref('')
const totalReward = ref('0.00')
const directCount = ref(0)
const productStats = ref([])
const commissionTiers = ref([])
const showQRModal = ref(false)

const bonusStats = ref({ kycInviteCount: 0, totalBonus: '0', nextBonus: null, isMaxReached: false })
const bonusTiers = ref([])
const activeProgressTab = ref('commission')

const usedBonusCount = computed(() => Math.min(bonusStats.value.kycInviteCount || 0, 10))

const generateInviteContent = () => {
  const mainDomain = import.meta.env.VITE_MAIN_DOMAIN || 'agx.bi'
  inviteLink.value = `https://${mainDomain}/register?ref=${inviteCode.value}`
  inviteText.value = `AGX数字黄金 - 好友赠送你10 AGX

邀请你加入AGX平台，一起赚取数字黄金！

注册奖励：
- 注册即送 10 AGX

更多福利：
- 完成KYC认证再送 5 USDT
- 首次建仓享高额返佣
- 建仓越多返佣越高，最高30%

专属邀请链接：
${inviteLink.value}

邀请码：${inviteCode.value}

点击链接立即注册，开启数字黄金之旅！`
}

const totalPositions = computed(() => productStats.value.reduce((sum, p) => sum + (p.validInvites || 0), 0))

const currentTierRate = computed(() => {
  const tier = getCurrentTier()
  return tier ? tier.rate : '3%'
})

const getCurrentTier = () => {
  for (let i = commissionTiers.value.length - 1; i >= 0; i--) {
    if (totalPositions.value >= commissionTiers.value[i].minInvites) return commissionTiers.value[i]
  }
  return commissionTiers.value[0]
}

const isCurrentTier = (tier) => getCurrentTier()?.tierLevel === tier.tierLevel

const formatNum = (n) => parseFloat(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })

const copyCode = async () => {
  try { await navigator.clipboard.writeText(inviteCode.value); await alert('邀请码已复制') } catch { await alert('复制失败') }
}

const copyLink = async () => {
  try {
    await navigator.clipboard.writeText(inviteText.value)
    await alert('邀请内容已复制')
    showQRModal.value = false
  } catch {
    await alert('复制失败')
  }
}

const getTierLabel = (min) => {
  if (min <= 3) return '1-3人'
  if (min <= 9) return '4-9人'
  if (min <= 15) return '10-15人'
  if (min <= 25) return '16-25人'
  return '25+人'
}

// 计算进度百分比
const progressPercent = computed(() => {
  const next = nextTierMin.value || 1
  const current = totalPositions.value || 0
  return Math.min((current / next) * 100, 0)
})

const nextTierRequired = computed(() => {
  const next = nextTierMin.value || 0
  const current = totalPositions.value || 0
  return Math.max(0, next - current)
})

const fetchData = async () => {
  try {
    const [infoRes, tiersRes, productRes, bonusStatsRes, bonusTiersRes] = await Promise.all([
      api.invite.getInfo(),
      api.invite.getCommissionTiers(),
      api.invite.getCommissionByProduct(),
      api.invite.getBonusStats(),
      api.invite.getInviteBonusTiers()
    ])
    if (infoRes.success && infoRes.data) {
      inviteCode.value = infoRes.data.inviteCode || 'AGX' + Math.random().toString(36).slice(2, 8).toUpperCase()
      generateInviteContent()
      totalReward.value = formatNum(infoRes.data.totalCommission || 0)
      directCount.value = infoRes.data.inviteCount || 0
    } else {
      generateInviteContent()
    }
    if (tiersRes.success && tiersRes.data?.length > 0) {
      commissionTiers.value = tiersRes.data.map(t => ({ ...t, label: getTierLabel(t.minInvites), rate: (t.commissionRate * 100).toFixed(0) + '%' }))
    } else {
      commissionTiers.value = [
        { tierLevel: 1, minInvites: 1, rate: '3%', label: '1-3人' },
        { tierLevel: 2, minInvites: 4, rate: '8%', label: '4-9人' },
        { tierLevel: 3, minInvites: 10, rate: '12%', label: '10-15人' },
        { tierLevel: 4, minInvites: 16, rate: '18%', label: '16-25人' },
        { tierLevel: 5, minInvites: 26, rate: '30%', label: '25+人' }
      ]
    }
    if (productRes.success && productRes.data) {
      productStats.value = productRes.data.products || productRes.data || []
    }
    if (bonusStatsRes.success && bonusStatsRes.data) {
      bonusStats.value = bonusStatsRes.data
    }
    if (bonusTiersRes.success && bonusTiersRes.data?.length > 0) {
      bonusTiers.value = bonusTiersRes.data
    } else {
      bonusTiers.value = [
        { inviteOrder: 1, inviteeBonus: '10', inviterBonus: '5' },
        { inviteOrder: 2, inviteeBonus: '10', inviterBonus: '8' },
        { inviteOrder: 3, inviteeBonus: '10', inviterBonus: '12' },
        { inviteOrder: 4, inviteeBonus: '10', inviterBonus: '18' },
        { inviteOrder: 5, inviteeBonus: '10', inviterBonus: '25' },
        { inviteOrder: 6, inviteeBonus: '10', inviterBonus: '32' },
        { inviteOrder: 7, inviteeBonus: '10', inviterBonus: '42' },
        { inviteOrder: 8, inviteeBonus: '10', inviterBonus: '55' },
        { inviteOrder: 9, inviteeBonus: '10', inviterBonus: '70' },
        { inviteOrder: 10, inviteeBonus: '10', inviterBonus: '90' }
      ]
    }
  } catch (e) {
    commissionTiers.value = [
      { tierLevel: 1, minInvites: 1, rate: '3%', label: '1-3人' },
      { tierLevel: 2, minInvites: 4, rate: '8%', label: '4-9人' },
      { tierLevel: 3, minInvites: 10, rate: '12%', label: '10-15人' },
      { tierLevel: 4, minInvites: 16, rate: '18%', label: '16-25人' },
      { tierLevel: 5, minInvites: 26, rate: '30%', label: '25+人' }
    ]
    bonusTiers.value = [
      { inviteOrder: 1, inviteeBonus: '10', inviterBonus: '5' },
      { inviteOrder: 2, inviteeBonus: '10', inviterBonus: '8' },
      { inviteOrder: 3, inviteeBonus: '10', inviterBonus: '12' },
      { inviteOrder: 4, inviteeBonus: '10', inviterBonus: '18' },
      { inviteOrder: 5, inviteeBonus: '10', inviterBonus: '25' },
      { inviteOrder: 6, inviteeBonus: '10', inviterBonus: '32' },
      { inviteOrder: 7, inviteeBonus: '10', inviterBonus: '42' },
      { inviteOrder: 8, inviteeBonus: '10', inviterBonus: '55' },
      { inviteOrder: 9, inviteeBonus: '10', inviterBonus: '70' },
      { inviteOrder: 10, inviteeBonus: '10', inviterBonus: '90' }
    ]
  }
}

onMounted(fetchData)
</script>

