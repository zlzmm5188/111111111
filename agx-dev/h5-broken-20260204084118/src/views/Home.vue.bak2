/* AI助手特殊样式 - 渐变动画 */
.ai-item {
  cursor: pointer;
}

.ai-icon {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, rgba(200, 170, 110, 0.2) 0%, rgba(200, 170, 110, 0.08) 100%);
  border: 1px solid rgba(200, 170, 110, 0.3);
}

.ai-glow {
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(200, 170, 110, 0.4) 60deg,
    transparent 120deg,
    transparent 180deg,
    rgba(200, 170, 110, 0.3) 240deg,
    transparent 300deg,
    transparent 360deg
  );
  animation: ai-rotate 3s linear infinite;
  z-index: 0;
}

@keyframes ai-rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.ai-icon::after {
  content: '';
  position: absolute;
  inset: 2px;
  background: linear-gradient(145deg, #1E262F 0%, #181F28 100%);
  border-radius: 10px;
  z-index: 1;
}

.ai-icon svg {
  z-index: 2;
  filter: drop-shadow(0 0 4px rgba(200, 170, 110, 0.5));
}

.ai-item span {
  background: linear-gradient(90deg, #C8AA6E, #F5D063, #C8AA6E);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: ai-text-shine 3s linear infinite;
}

@keyframes ai-text-shine {
  0% { background-position: 0% center; }
  100% { background-position: 200% center; }
}


