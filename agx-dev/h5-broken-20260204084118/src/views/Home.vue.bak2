  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 3px;
  margin: 3px 0;
}

.skeleton-text.w60 { width: 60%; }
.skeleton-text.w50 { width: 50%; }
.skeleton-text.w40 { width: 40%; }
.skeleton-text.w30 { width: 30%; }

.market-item.skeleton .market-rank {
