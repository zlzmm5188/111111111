              <path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            </svg>
          </div>
          <span>{{ $t('home.contract') }}</span>
        </router-link>
        <!-- 黄金 - 金块图标 -->
        <router-link to="/gold" class="quick-item">
          <div class="quick-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M4 17l2-7h12l2 7H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M6 10l1.5-4h9L18 10" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M8 14h8M9 17h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
