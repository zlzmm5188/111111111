          >
            <div class="ticker-header">
              <img v-if="item.flag" :src="item.flag" class="ticker-flag" :alt="item.symbol" loading="lazy">
              <img v-else :src="item.icon" class="ticker-icon" :alt="item.symbol" loading="lazy">
