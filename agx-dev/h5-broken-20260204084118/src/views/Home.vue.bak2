              <path d="M9 18H6v-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M18 6l-6 6M6 18l6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span>{{ $t('home.otc') }}</span>
        </router-link>
        <!-- AI助手 - 智能图标（渐变动画） -->
        <div class="quick-item ai-item" @click="handleAiClick">
          <div class="quick-icon ai-icon">
            <div class="ai-glow">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="5" y="7" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="9" cy="12" r="1.5" stroke="currentColor" stroke-width="1.2"/>
              <circle cx="15" cy="12" r="1.5" stroke="currentColor" stroke-width="1.2"/>
              <path d="M10 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M12 7V4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M9 4h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M3 11v2M21 11v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </router-link>
          <span>{{ $t('home.aiAssistant') }}</span>
        </router-link>
      </router-link>
    </section>

    <!-- 热门行情 -->
    <section class="market-section">
      <div class="market-list">
        <!-- 骨架屏 -->
        <template v-if="isLoading">
          <div class="market-item skeleton" v-for="i in 5" :key="'sk-'+i">
            <span class="market-rank skeleton-box"></span>
            <div class="market-icon skeleton-box"></router-link>
            <div class="market-info">
              <span class="skeleton-text w60"></span>
              <span class="skeleton-text w40"></span>
            </router-link>
            <div class="market-price">
              <span class="skeleton-text w50"></span>
              <span class="skeleton-text w30"></span>
            </router-link>
          </router-link>
        </template>
        <!-- 实际数据 -->
        <router-link 
          v-else
          v-for="(coin, index) in marketCoins" 
          :key="coin.symbol" 
          :to="`/trade?pair=${coin.symbol}_USDT`"
          class="market-item"
        >
          <span class="market-rank" :class="{ top: index < 3 }">{{ index + 1 }}</span>
          <img :src="coin.icon" class="market-icon" :alt="coin.symbol" loading="lazy">
          <div class="market-info">
            <span class="market-name">{{ coin.symbol }}<small>/USDT</small></span>
            <span class="market-vol">Vol {{ coin.volume }}</span>
          </router-link>
          <div class="market-price">
            <span class="price-val">${{ coin.price }}</span>
            <span class="price-change" :class="coin.change >= 0 ? 'up' : 'down'">
              {{ coin.change >= 0 ? '+' : '' }}{{ coin.change }}%
            </span>
          </router-link>
        </router-link>
      </div>
    </section>
    </div>
  </div>
</template>

<script setup>
defineOptions({
  name: 'Home'
})

import { ref, onMounted, onUnmounted, onActivated, onDeactivated, computed, nextTick } from 'vue'
import { useI18n } from 'vue-i18n'
import api from '../utils/api'
import { showError } from '@/utils/alert'

const { t } = useI18n()



const countdown = ref({ days: '00', hours: '00', mins: '00', secs: '00' })
const prevCountdown = ref({ days: '00', hours: '00', mins: '00', secs: '00' })
const flipState = ref({ days: false, hours: false, mins: false, secs: false })
const isLoading = ref(true)

const hotCoins = ref([
  { symbol: 'BTC', price: '$99,870.88', change: 2.41, icon: '/crypto/btc.png' },
  { symbol: 'ETH', price: '$3,572.15', change: 3.54, icon: '/crypto/eth.png' },
  { symbol: 'SOL', price: '$186.06', change: -1.03, icon: '/crypto/sol.png' }
])

// 更多加密货币
const moreCrypto = ref([
  { symbol: 'BNB', price: '$715.50', change: 1.28, icon: '/crypto/bnb.png' },
  { symbol: 'XRP', price: '$2.35', change: 5.67, icon: '/crypto/xrp.png' },
  { symbol: 'ADA', price: '$0.92', change: -0.85, icon: '/crypto/ada.png' }
])

const moreCrypto2 = ref([
  { symbol: 'DOGE', price: '$0.168', change: 3.22, icon: '/crypto/doge.png' },
  { symbol: 'DOT', price: '$8.45', change: -1.56, icon: '/crypto/dot.png' },
  { symbol: 'AVAX', price: '$42.30', change: 2.89, icon: '/crypto/avax.png' }
])

// 外汇数据
const forexData = ref([
  { symbol: 'EUR/USD', price: '$1.0875', change: 0.15, flag: 'https://flagcdn.com/w40/eu.png' },
  { symbol: 'GBP/USD', price: '$1.2650', change: -0.22, flag: 'https://flagcdn.com/w40/gb.png' },
  { symbol: 'USD/JPY', price: '¥145.80', change: 0.35, flag: 'https://flagcdn.com/w40/jp.png' }
])

const forexData2 = ref([
  { symbol: 'AUD/USD', price: '$0.6580', change: -0.45, flag: 'https://flagcdn.com/w40/au.png' },
  { symbol: 'USD/CAD', price: '$1.3650', change: 0.28, flag: 'https://flagcdn.com/w40/ca.png' },
  { symbol: 'USD/CHF', price: '$0.8920', change: -0.18, flag: 'https://flagcdn.com/w40/ch.png' }
])

// 所有行情数据轮播
const allTickerData = [
  () => hotCoins.value,
  () => moreCrypto.value,
  () => forexData.value,
  () => moreCrypto2.value,
  () => forexData2.value
]

// 当前显示类型索引
const currentTickerType = ref(0)
const currentTickerData = computed(() => {
  return allTickerData[currentTickerType.value]()
})

const marketCoins = ref([
  { symbol: 'BTC', price: '99,870.88', change: 2.41, volume: '12.5K', icon: '/crypto/btc.png' },
  { symbol: 'ETH', price: '3,572.15', change: 3.54, volume: '85.2K', icon: '/crypto/eth.png' },
  { symbol: 'SOL', price: '186.06', change: -1.03, volume: '25.8K', icon: '/crypto/sol.png' },
  { symbol: 'BNB', price: '715.50', change: 1.28, volume: '18.3K', icon: '/crypto/bnb.png' },
  { symbol: 'XRP', price: '2.35', change: 5.67, volume: '156.7K', icon: '/crypto/xrp.png' }
])

// 黄金现货数据
const goldData = ref({
  name: '',
  desc: '',
  price: '2,650.00',
  change: 0.35
})

// 金价显示价格（带小数跳动效果）
const goldDisplayPrice = ref('2,650.00')
const priceTicking = ref(false)
const changeTicking = ref(false)
const displayChange = ref(0.35)

// Banner轮播数据 - 使用computed实现响应式i18n
const bannerSlide = ref(0)
const bannerData = computed(() => [
  {
    badge: t('banner.badge1'),
    title: t('banner.title1'),
    desc: t('banner.desc1')
  },
  {
    badge: t('banner.badge2'),
    title: t('banner.title2'),
    desc: t('banner.desc2')
  },
  {
    badge: t('banner.badge3'),
    title: t('banner.title3'),
    desc: t('banner.desc3')
  },
  {
    badge: t('banner.badge4'),
    title: t('banner.title4'),
    desc: t('banner.desc4')
  },
  {
    badge: t('banner.badge5'),
    title: t('banner.title5'),
    desc: t('banner.desc5')
  },
  {
    badge: t('banner.badge1'),
    title: t('banner.title1'),
    desc: t('banner.desc1')
  }
])

// 切换Banner
const switchBanner = () => {
  bannerSlide.value = (bannerSlide.value + 1) % bannerData.value.length
}

// 小数跳动效果 - 低频装饰性动画
let flickerCounter = 0
const flickerPrice = () => {
  flickerCounter++
  
  // 涨跌幅跳动 - 每秒都跳动
  const baseChange = parseFloat(goldData.value.change) || 0.35
  const changeFluctuation = (Math.random() - 0.5) * 0.04 // ±0.02%波动
  const newChange = (baseChange + changeFluctuation).toFixed(2)
  
  if (newChange !== displayChange.value.toString()) {
    changeTicking.value = true
    displayChange.value = parseFloat(newChange)
    setTimeout(() => {
      changeTicking.value = false
    }, 300)
  }
  
  // 价格跳动 - 每5秒才可能跳动一次，20%概率
  if (flickerCounter % 5 !== 0 || Math.random() > 0.2) return
  
  const basePrice = goldData.value.price
  if (!basePrice) return
  
  const parts = basePrice.split('.')
  if (parts.length !== 2) {
    goldDisplayPrice.value = basePrice
    return
  }
  
  const intPart = parts[0]
  const decPart = parts[1]
  
  // 随机微调最后1-2位小数
  let newDec = parseInt(decPart)
  const fluctuation = Math.floor(Math.random() * 3) - 1 // -1 到 +1，更小的波动
  newDec = Math.max(0, Math.min(99, newDec + fluctuation))
  
  const newPrice = `${intPart}.${String(newDec).padStart(2, '0')}`
  
  // 价格变化时触发动画
  if (newPrice !== goldDisplayPrice.value) {
    priceTicking.value = true
    goldDisplayPrice.value = newPrice
    setTimeout(() => {
      priceTicking.value = false
    }, 300)
  }
}

let mainTimer = null      // 合并后的主定时器
let tickCount = 0         // 计数器，用于控制不同频率的任务
const timeoutIds = []
// AGX正式发售日期 - 2026年2月28日
const countdownTarget = new Date('2026-02-28T00:00:00').getTime()

// 轮播切换行情类型
const switchTickerType = () => {
  currentTickerType.value = (currentTickerType.value + 1) % allTickerData.length
}

// 从后端获取黄金价格
const fetchGoldPrice = async () => {
  try {
    const res = await api.gold.getPrices()
    if (res.success && res.data) {
      const gold = res.data.gold || res.data
      if (gold && gold.price) {
        const formattedPrice = parseFloat(gold.price).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',')
        const changeVal = parseFloat(gold.change24h || 0.35)
        goldData.value = {
          name: t('home.goldSpot'),
          desc: t('home.goldDesc'),
          price: formattedPrice,
          change: changeVal.toFixed(2)
        }
        goldDisplayPrice.value = formattedPrice
        displayChange.value = changeVal
      }
    }
  } catch (e) {
    // 使用默认数据
    goldData.value.name = t('home.goldSpot')
    goldData.value.desc = t('home.goldDesc')
  }
}

// 从后端获取行情数据
const getLocalIcon = (symbol) => {
  const s = (symbol || '').replace('USDT', '').toLowerCase()
  return `/crypto/${s}.png`
}

const fetchMarketData = async () => {
  try {
    const res = await api.market.getTickers({ type: 'crypto', tab: 'all' })
    if (res.success && res.data && res.data.list) {
      const list = res.data.list.slice(0, 5)
      if (list.length > 0) {
        // 映射后端字段：lastPrice -> price, priceChangePercent -> change
        const validList = list.filter(item => {
          const price = item.lastPrice || item.price
          return price && parseFloat(price) > 0
        })
        if (validList.length > 0) {
          marketCoins.value = validList.map(item => {
            const sym = item.symbol?.replace('USDT', '') || item.name || item.symbol
            const price = parseFloat(item.lastPrice || item.price)
            const change = parseFloat(item.priceChangePercent || item.change24h || 0)
            return {
              symbol: sym,
              price: price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
              change: change,
              volume: item.quoteVolume ? (parseFloat(item.quoteVolume) / 1000000).toFixed(1) + 'M' : (item.volume ? (parseFloat(item.volume) / 1000).toFixed(1) + 'K' : '0'),
              icon: getLocalIcon(sym)
            }
          })
          // 更新热门币种
          if (validList.length >= 3) {
            hotCoins.value = validList.slice(0, 3).map(item => {
              const sym = item.symbol?.replace('USDT', '') || item.name || item.symbol
              const price = parseFloat(item.lastPrice || item.price)
              const change = parseFloat(item.priceChangePercent || item.change24h || 0)
              return {
                symbol: sym,
                price: '$' + price.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
                change: change,
                icon: getLocalIcon(sym)
              }
            })
          }
        }
      }
    }
  } catch (e) {
    // 使用默认数据
  } finally {
    isLoading.value = false
  }
}

const updateCountdown = () => {
  const diff = countdownTarget - Date.now()
  if (diff > 0) {
    const d = Math.floor(diff / 86400000)
    const h = Math.floor((diff % 86400000) / 3600000)
    const m = Math.floor((diff % 3600000) / 60000)
    const s = Math.floor((diff % 60000) / 1000)
    const newVal = {
      days: String(d).padStart(2, '0'),
      hours: String(h).padStart(2, '0'),
      mins: String(m).padStart(2, '0'),
      secs: String(s).padStart(2, '0')
    }
    // 检测变化并触发翻牌
    const keys = ['days', 'hours', 'mins', 'secs']
    keys.forEach(key => {
      if (newVal[key] !== countdown.value[key]) {
        prevCountdown.value[key] = countdown.value[key]
        flipState.value[key] = true
        const timeoutId = setTimeout(() => { flipState.value[key] = false }, 600)
        timeoutIds.push(timeoutId)
      }
    })
    countdown.value = newVal
  }
}

const handleImgError = (e) => {
  e.target.style.background = 'linear-gradient(135deg, #C9A962, #8B7355)'
  e.target.src = 'data:,'
}

// 生成迷你走势图路径
const chartCache = {}
const getChartLine = (change, symbol) => {
  const key = `${symbol}-${change > 0 ? 'up' : 'down'}`
  if (chartCache[key]) return chartCache[key]
  
  const points = []
  const seed = symbol.split('').reduce((a, c) => a + c.charCodeAt(0), 0)
  const isUp = change >= 0
  
  for (let i = 0; i <= 12; i++) {
    const x = (i / 12) * 60
    const trend = isUp ? (12 - i) * 1.2 : i * 1.2
    const noise = Math.sin(seed + i * 0.8) * 4 + Math.cos(seed * 0.5 + i * 1.2) * 3
    const y = 12 + trend + noise
    points.push(`${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${Math.max(2, Math.min(22, y)).toFixed(1)}`)
  }
  
  chartCache[key] = points.join(' ')
  return chartCache[key]
}

const getChartPath = (change, symbol) => {
  const line = getChartLine(change, symbol)
  return `${line} L60,24 L0,24 Z`
}

// 启动定时器 - 优化：合并为单一定时器，减少性能开销
const startTimers = () => {
  if (mainTimer) return // 防止重复启动
  tickCount = 0
  
  mainTimer = setInterval(() => {
    tickCount++
    
    // 每秒：倒计时更新
    updateCountdown()
    
    // 每5秒：价格微调动画（降低频率，减少重渲染）
    if (tickCount % 5 === 0) {
      flickerPrice()
    }
    
    // 每8秒：轮播切换
    if (tickCount % 8 === 0) {
      switchBanner()
      switchTickerType()
    }
    
    // 每30秒：数据刷新
    if (tickCount % 30 === 0) {
      fetchGoldPrice()
      fetchMarketData()
    }
  }, 1000)
}

// 停止定时器
const stopTimers = () => {
  if (mainTimer) { clearInterval(mainTimer); mainTimer = null }
  tickCount = 0
}

onMounted(async () => {
  await nextTick()
  // 首次加载数据
  setTimeout(async () => {
    updateCountdown()
    fetchGoldPrice()
    fetchMarketData()
  }, 100)
  // 延迟启动定时器
  setTimeout(startTimers, 500)
})

// keep-alive 激活时恢复定时器
onActivated(() => {
  startTimers()
})

// keep-alive 停用时暂停定时器
onDeactivated(() => {
  stopTimers()
})

onUnmounted(() => { 
  stopTimers()
  timeoutIds.forEach(id => clearTimeout(id))
  timeoutIds.length = 0
})
</script>

