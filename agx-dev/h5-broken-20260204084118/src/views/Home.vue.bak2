  transition: transform 0.15s ease;
  pointer-events: auto;
  z-index: 2;
  position: relative;
}

.quick-item:active {
  transform: scale(0.95);
}



/* 确保AI图标有足够空间 */
.quick-item.ai-item 


.quick-item:active 

.quick-item span {
